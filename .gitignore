# macOS
.DS_Store

# KiCad local history, backups and lock files
.history/
*-backups/
*.lck
_autosave-*

# Python
__pycache__/

# Local builds (JUCE install, plugin-check, ...)
/build/

# Test results per commit, read by the deploy gate (.claude/hooks/pre-bash.py)
tests/.status/

# The lab lock: present while a person has the boards
.claude/lab.lock

# Git worktrees of the agents (isolation: worktree), each on its own branch
.claude/worktrees/

# mermaid-check dependencies
tools/mermaid-check/node_modules/
