{
  "version": 2,
  "about": [
    "Which checks of tools/test.sh cover a file: what `tools/test.sh changed` runs for the files",
    "changed. The first rule whose pattern matches a path decides (fnmatch on the path from the",
    "repository's root, where * also matches /). \"plugin\" is the plugin-check of the plugin whose",
    "folder the path is in; \"self\" is the changed test module of tests/vpair itself, with every",
    "module that imports it. A path no rule names is reported, and the levels cover it."
  ],
  "rules": [
    {
      "why": "words and drawings",
      "paths": ["*.md", "docs/*", "hardware/*", "all.jpeg", "tools/render.sh", "tools/blender.sh", ".claude/*"],
      "checks": []
    },
    {
      "why": "one plugin",
      "paths": ["dsp/juce_plugins/crossover/*", "dsp/juce_plugins/firConv/*", "dsp/juce_plugins/loudness/*", "dsp/juce_plugins/ampScope/*"],
      "checks": ["plugin", "chain"]
    },
    {
      "why": "what every plugin shares",
      "paths": ["dsp/juce_plugins/*", "dsp/juce_apps/plugin-check/*"],
      "checks": ["plugins", "chain"]
    },
    {
      "why": "speakerd",
      "paths": ["dsp/juce_apps/speakerd/*"],
      "checks": ["speakerd", "installers", "pair", "chain"]
    },
    {
      "why": "the controller",
      "paths": ["dsp/juce_apps/controller/*"],
      "checks": ["controller"]
    },
    {
      "why": "ampd",
      "paths": ["firmware/ampd/ampd.py"],
      "checks": ["ampd", "pair", "controller"]
    },
    {
      "why": "the installers, what they install around speakerd, and the board script",
      "paths": ["firmware/*.sh", "firmware/speakerd/*", "firmware/ampd/*", "firmware/pipewire/*", "tools/board.sh"],
      "checks": ["installers"]
    },
    {
      "why": "a test module of the virtual pair",
      "paths": ["tests/vpair/test_*.py"],
      "checks": ["self"]
    },
    {
      "why": "the virtual pair itself",
      "paths": ["tests/vpair/*"],
      "checks": ["speakerd", "ampd", "pair", "controller", "installers", "chain"]
    },
    {
      "why": "the test tools",
      "paths": ["tools/test.sh", "tools/status.py", "tools/impact.py", "tools/tests/*", "tests/impact.json"],
      "checks": ["tools"]
    }
  ]
}
