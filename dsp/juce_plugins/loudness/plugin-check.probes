# Parameter values (normalised 0..1) that plugin-check sets before its audio check, so the
# check exercises the DSP instead of a flat, do-nothing setting. One <paramID>=<value> per line.
# Setting 2 rather than 1, so the active-setting monitor reads something other than its default.
mode=0.5          # Force 2: setting 2 (index 1) regardless of level
s1_e0_gain=0.75   # setting 2, EQ1 gain +12 dB
