# Machine-specific settings for this repository.
#
#     cp config/local.env.example config/local.env     # then edit config/local.env
#
# config/local.env is gitignored: it is where anything private or specific to your setup
# lives (device names, the hostname of your target board, local paths). Nothing in the
# tracked source hard-codes these values.
#
# Format: plain KEY=VALUE lines, '#' comments, optional quotes. The file is PARSED, never
# executed, by both the Python tools (python_dsp_tools/nearfield/config.py) and the plugin
# build scripts (juce_plugins/tools/common.sh). A variable already set in the environment
# wins over this file, e.g.  DEPLOY_HOST=pi@other.local ./juce_plugins/tools/build-podman.sh ...
# Empty values count as unset.

# ---------------------------------------------------------------------------------------
# Python tools (python_dsp_tools/)
# ---------------------------------------------------------------------------------------

# Audio devices the measurement GUI preselects, matched as case-insensitive substrings of
# the names sounddevice reports (the GUI's dropdowns list them). Empty = "default" device.
NF_INPUT_DEVICE=
NF_OUTPUT_DEVICE=

# Folder the measurement GUI saves captures to and the tuning GUI loads them from.
# Relative paths are relative to the repository root. Default: python_dsp_tools/data
NF_DATA_DIR=

# Root the tuning GUI's "Export C++ headers" writes under; each header goes into the plugin
# folder that compiles it (crossover/, firConv/). Default: juce_plugins
NF_EXPORT_DIR=

# ---------------------------------------------------------------------------------------
# JUCE plugins (juce_plugins/)
# ---------------------------------------------------------------------------------------

# ssh destination the build scripts' -install step deploys the .lv2 bundles to, as
# user@host (key-based ssh login recommended). Required only for -install.
DEPLOY_HOST=

# LV2 folder on the target, relative to the remote home. Keep it one of the default LV2
# search paths (~/.lv2), see docs/juce-knowledge/hosting/lv2-discovery.md. Default: .lv2
DEPLOY_LV2_DIR=
