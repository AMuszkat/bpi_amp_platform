# Per-developer settings. Copy to local.mk (gitignored) and adjust:
#   cp local.mk.example local.mk
# Read by Makefile and localBuild/Makefile, and (BOARD_HOST, BOARD_USER) by
# setup.sh, speakerd-setup.sh and tools/board.sh, which parse this file without
# running make. Any of these can instead come from the environment
# (export BOARD_HOST=...), which wins. The snapcast, usb-serial and wifi setup
# scripts read the environment only (or take --target-host). BOARD_USER is the
# board's audio user, the one whose PipeWire drives the amplifier, never root.

# Network name or address of the board
BOARD_HOST := bpi-amp.local

# Unprivileged user on the board (localBuild/ builds modules natively as this user)
BOARD_USER := user

# Kernel source tree (default: ./linuxMainLine)
# LINUX := /path/to/linux

# The file holding the speaker pair's secret, which ampd's controllers prove (setup.sh's ampd
# component copies it to each board with the bundle; never put the secret itself in a tracked file).
# Make one with: python3 -c 'import secrets; print(secrets.token_hex(24))' > ~/.config/bpi-amp/ampd.secret
# AMPD_SECRET_FILE := /path/to/ampd.secret
